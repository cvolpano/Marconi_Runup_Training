+def load_npz(example):
+    with np.load(example.numpy()) as data:
+        image = data['arr_0'].astype('uint8')
+        image = standardize(image)
+        label = data['arr_1'].astype('uint8')
+        try:
+            file = [''.join(f) for f in data['files']]
+        except:
+            file = [f]
+    return image, label, file[0]
